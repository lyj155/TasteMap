/* pages/index/index.wxss 首页：校园美食地图 */
.page {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

/* ===== 顶部悬浮区 ===== */
.top-bar {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 12rpx 0 26rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(10px);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-placeholder {
  color: #B5B5B5;
}

.search-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #FF8C00, #FFA945);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 32rpx;
}

.switch-row {
  margin-top: 18rpx;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.switch-label {
  font-size: 24rpx;
  color: #555;
  margin-right: 14rpx;
}

/* ===== 底部提示 ===== */
.bottom-tip {
  position: absolute;
  bottom: 56rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  padding: 16rpx 36rpx;
  background: rgba(0, 0, 0, 0.68);
  color: #fff;
  font-size: 24rpx;
  border-radius: 40rpx;
  white-space: nowrap;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

/* ===== 定位授权遮罩（模糊背景） ===== */
.location-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(247, 246, 242, 0.55);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.location-card {
  width: 520rpx;
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.location-icon {
  font-size: 72rpx;
}

.location-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2B2B2B;
}

.location-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

.location-btn {
  margin-top: 40rpx;
  padding: 20rpx 80rpx;
  background: linear-gradient(135deg, #FF8C00, #FFA945);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 0, 0.35);
}
