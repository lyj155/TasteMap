<!--pages/profile/profile.wxml 我的-->
<view class="page">
  <!-- 顶部用户卡片 -->
  <view class="user-card card">
    <!-- 已登录且上传过头像：显示头像；否则显示灰色默认头像 -->
    <image wx:if="{{user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-default">
      <text class="avatar-default-icon">👤</text>
    </view>
    <view class="user-info">
      <view class="nick">{{user.nick}}</view>
      <view class="sign">{{user.sign}}</view>
    </view>
    <button wx:if="{{!isLogged}}" class="login-btn" bindtap="onGoLogin">去登录</button>
    <view wx:else class="edit-btn" bindtap="onEditProfile">编辑资料</view>
  </view>

  <!-- 数据栏：三列 -->
  <view class="stats card">
    <view class="stat" wx:for="{{stats}}" wx:key="label">
      <view class="stat-num">{{item.num}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 功能网格：四个入口 -->
  <view class="grid card">
    <view
      class="grid-item"
      wx:for="{{menus}}"
      wx:key="name"
      data-name="{{item.name}}"
      bindtap="onMenuTap"
    >
      <view class="grid-icon" style="background: {{item.bg}};">{{item.icon}}</view>
      <view class="grid-name">{{item.name}}</view>
    </view>
  </view>

  <!-- 最近足迹 -->
  <view class="footprint card">
    <view class="section-title">最近足迹</view>
    <view class="section-sub">过去 7 天你在校园周边留下了这些味道</view>
    <!-- 横向打卡地图截图（CSS 模拟） -->
    <view class="footprint-map">
      <view class="map-line v-line" style="left: 30%;"></view>
      <view class="map-line v-line" style="left: 62%;"></view>
      <view class="map-line h-line" style="top: 38%;"></view>
      <view class="map-line h-line" style="top: 72%;"></view>
      <view class="map-road"></view>
      <view class="map-pin" wx:for="{{pins}}" wx:for-item="pin" wx:key="index"
        style="left: {{pin.x}}%; top: {{pin.y}}%;"></view>
      <view class="map-me">我在这里</view>
    </view>
    <!-- 足迹文字 -->
    <view class="footprint-text" wx:for="{{footprints}}" wx:key="id">
      <text class="fp-dot">●</text>
      <text class="fp-place">{{item.place}}</text>
      <text class="fp-time">{{item.time}}</text>
    </view>
  </view>

  <!-- 登录 / 编辑资料弹窗 -->
  <view class="mask" wx:if="{{showEdit}}" bindtap="onCloseEdit">
    <view class="edit-modal" catchtap="preventTap">
      <view class="modal-title">{{isLogged ? '编辑资料' : '完善个人信息'}}</view>
      <view class="modal-sub">{{isLogged ? '修改你的头像、昵称和签名' : '登录后将使用微信头像和昵称'}}</view>

      <!-- 微信官方头像填写能力：open-type=chooseAvatar -->
      <button
        class="avatar-choose"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image wx:if="{{draft.avatar}}" class="modal-avatar" src="{{draft.avatar}}" mode="aspectFill" />
        <view wx:else class="modal-avatar modal-avatar-default">
          <text class="avatar-default-icon">👤</text>
        </view>
        <text class="avatar-tip">{{draft.avatar ? '点击更换头像' : '点击获取微信头像'}}</text>
      </button>

      <!-- 微信官方昵称填写能力：type=nickname 键盘会推荐微信昵称 -->
      <input
        class="modal-input"
        type="nickname"
        placeholder="昵称"
        placeholder-class="input-placeholder"
        value="{{draft.nick}}"
        bindinput="onNickInput"
        bindblur="onNickBlur"
      />
      <input
        class="modal-input"
        placeholder="个性签名（选填）"
        placeholder-class="input-placeholder"
        value="{{draft.sign}}"
        bindinput="onSignInput"
      />

      <view class="modal-btns">
        <view class="modal-btn cancel" bindtap="onCloseEdit">取消</view>
        <view class="modal-btn confirm" bindtap="onSaveProfile">保存</view>
      </view>
    </view>
  </view>
</view>
