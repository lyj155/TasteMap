/* custom-tab-bar/index.wxss 自定义底部导航 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 999;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 6rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9A9A9A;
}

.tab-text.active {
  color: #FF8C00;
  font-weight: 700;
}

/* 中间凸起的"+"按钮 */
.publish-btn {
  width: 100rpx;
  height: 100rpx;
  margin-top: -56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C00, #FFA945);
  border: 8rpx solid #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.publish-plus {
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1;
  margin-top: -6rpx;
}
