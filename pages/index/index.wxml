<!--pages/index/index.wxml 首页：校园美食地图-->
<view class="page">
  <!-- 全屏地图 -->
  <map
    id="campusMap"
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="16"
    markers="{{markers}}"
    show-location="{{true}}"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  >
  </map>

  <!-- 顶部悬浮：搜索框 + 探索完整地图开关 -->
  <view class="top-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索店名 / 美食，如：牛肉面"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-btn" bindtap="onSearchConfirm">搜索</view>
    </view>
    <view class="switch-row">
      <text class="switch-label">探索完整地图</text>
      <switch checked="{{exploreAll}}" color="#FF8C00" bindchange="onExploreChange" />
    </view>
  </view>

  <!-- 底部悬浮文字提示 -->
  <view class="bottom-tip">灰色店铺暂无真实体验帖 · 打开右上开关探索全部</view>

  <!-- 定位授权遮罩：授权成功前地图处于模糊状态 -->
  <view class="location-mask" wx:if="{{!located}}">
    <view class="location-card card">
      <text class="location-icon">📍</text>
      <view class="location-title">{{locating ? '正在定位…' : '开启定位'}}</view>
      <view class="location-desc">
        {{locating ? '正在寻找你附近的美食' : '开启定位后，为你展示校园附近真实美食'}}
      </view>
      <view class="location-btn" wx:if="{{!locating}}" bindtap="onRetryLocation">去授权定位</view>
    </view>
  </view>
</view>
