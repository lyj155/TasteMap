<!--pages/publish/publish.wxml 发布页：中间"+"按钮的跳转目标-->
<view class="page">
  <!-- 类型选择 -->
  <view class="type-seg card">
    <view class="seg-item {{type === 0 ? 'active' : ''}}" data-index="0" bindtap="onTypeChange">发评价</view>
    <view class="seg-item {{type === 1 ? 'active' : ''}}" data-index="1" bindtap="onTypeChange">发帖子</view>
  </view>

  <!-- 表单 -->
  <view class="form card">
    <view class="form-label">标题</view>
    <input
      class="form-input"
      placeholder="一句话描述这次美食体验"
      placeholder-class="input-placeholder"
      value="{{title}}"
      bindinput="onTitleInput"
    />

    <view class="form-label">正文</view>
    <textarea
      class="form-textarea"
      placeholder="说说味道、环境、价格…真实体验才更有价值哦"
      placeholder-class="input-placeholder"
      value="{{content}}"
      maxlength="300"
      bindinput="onContentInput"
    />
    <view class="word-count">{{content.length}}/300</view>

    <view class="form-label">添加图片</view>
    <view class="img-grid">
      <image
        class="img-item"
        wx:for="{{images}}"
        wx:key="*this"
        src="{{item}}"
        mode="aspectFill"
        data-index="{{index}}"
        bindtap="onPreviewImage"
      />
      <view class="img-add" wx:if="{{images.length < 3}}" bindtap="onChooseImage">＋</view>
    </view>

    <view class="form-label">店铺定位 <text class="required">必选</text></view>
    <view class="shop-pick {{location ? 'picked' : ''}}" bindtap="onRelocate">
      <text>{{locating ? '正在获取定位…' : (location ? locationText : '定位失败，请授权后重试')}}</text>
      <view class="loc-actions">
        <text class="loc-edit" wx:if="{{location}}" catchtap="onRelocate">去修改</text>
        <text class="loc-edit" wx:elif="{{!locating}}" catchtap="onOpenLocationSetting">去授权</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-btn" bindtap="onSubmit">发布</view>
  <view class="tip">提交后需通过真实体验确认，才会展示给同学们~</view>
</view>
